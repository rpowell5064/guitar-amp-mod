@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

# Port groups: generic-UI hosts (Zynthian) page the controls by these.
<https://rpowell5064.github.io/guitaramp-suite/comp#g_comp>
    a pg:Group ; lv2:symbol "g_comp" ; lv2:name "Compressor" .
<https://rpowell5064.github.io/guitaramp-suite/comp#g_env>
    a pg:Group ; lv2:symbol "g_env" ; lv2:name "Envelope" .

<https://rpowell5064.github.io/guitaramp-suite/comp>
    a lv2:Plugin, lv2:CompressorPlugin ;
    rdfs:label "Hex Chain — Compressor" ;
    doap:name  "Hex Chain Compressor" ;
    # PatchStorage listing content (uploader reads the plugin-level rdfs:comment)
    rdfs:comment """Transparent guitar/bass compressor.

A musical, low-CPU compressor for evening out picking dynamics and adding sustain — equally at home on guitar and bass, in front of a dirt pedal or across a clean signal. Runs on every target including 32-bit Pi.

Free and open source (GPL-3).""" ;
    mod:label  "Compressor" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 2 ;
    lv2:microVersion 33 ;   # 33: lv2:enabled block-enable port added at the END (designated so generic-UI hosts can bind it as the bypass; INVERTED sense, 1 = on). The existing bypass port is unmoved: renumbering it would shift every port after it and invalidate saved boards. 32: LV2 port groups (generic-UI hosts like Zynthian page the controls by these; metadata only)
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "comp_type" ; lv2:name "Type" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/comp#g_comp> ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:scalePoint [ rdfs:label "5 Creature Amp" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Once76" ; rdf:value 1 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ; lv2:symbol "threshold" ; lv2:name "Threshold" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/comp#g_comp> ;
        units:unit units:db ;
        lv2:default -18.0 ; lv2:minimum -60.0 ; lv2:maximum 0.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "ratio" ; lv2:name "Ratio" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/comp#g_comp> ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 4 ;
        lv2:scalePoint [ rdfs:label "2:1"   ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "4:1"   ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "8:1"   ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "20:1"  ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Limit" ; rdf:value 4 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "attack" ; lv2:name "Attack" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/comp#g_env> ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "release" ; lv2:name "Release" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/comp#g_env> ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "knee" ; lv2:name "Knee" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/comp#g_env> ;
        lv2:default 3.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "makeup" ; lv2:name "Makeup" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/comp#g_comp> ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 9 ; lv2:symbol "gr_db" ; lv2:name "GR" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/comp#g_comp> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -40.0 ; lv2:maximum 0.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 10 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/comp#g_comp> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        # Host block-enable, designated per the LV2 spec so generic-UI hosts
        # (Zynthian, MOD, KosmOS) can bind it as the plugin's bypass switch
        # instead of listing it as an ordinary parameter.  NOTE the sense is
        # INVERTED relative to the "bypass" port above: enabled 1 = processing
        # on, 0 = bypassed.  Deliberately ungrouped and last, so a host that
        # ignores the designation still shows it at the END of the list.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 11 ; lv2:symbol "enabled" ; lv2:name "Enabled" ;
        lv2:designation lv2:enabled ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] ;

    modgui:gui [
        modgui:resourcesDirectory <modgui-comp> ;
        modgui:iconTemplate <modgui-comp/icon-comp.html> ;
        modgui:stylesheet <modgui-comp/stylesheet-comp.css> ;
        modgui:screenshot <modgui-comp/screenshot-comp.png> ;
        modgui:thumbnail <modgui-comp/thumbnail-comp.png> ;
        modgui:brand "Hex Chain" ;
        modgui:label "Compressor" ;
        modgui:model "mod-pedal-guitaramp-comp" ;
        modgui:port [
            lv2:index 0 ; lv2:symbol "comp_type" ; lv2:name "Type"
        ] , [
            lv2:index 1 ; lv2:symbol "threshold" ; lv2:name "Threshold"
        ] , [
            lv2:index 2 ; lv2:symbol "ratio"     ; lv2:name "Ratio"
        ] , [
            lv2:index 3 ; lv2:symbol "attack"    ; lv2:name "Attack"
        ] , [
            lv2:index 4 ; lv2:symbol "release"   ; lv2:name "Release"
        ] , [
            lv2:index 5 ; lv2:symbol "knee"      ; lv2:name "Knee"
        ] , [
            lv2:index 6 ; lv2:symbol "makeup"    ; lv2:name "Makeup"
        ] , [
            lv2:index 7 ; lv2:symbol "gr_db"     ; lv2:name "GR"
        ] , [
            lv2:index 8 ; lv2:symbol "bypass"    ; lv2:name "Bypass"
        ]
    ] .
