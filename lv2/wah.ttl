@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<https://rpowell5064.github.io/guitaramp-suite/wah>
    a lv2:Plugin, lv2:FilterPlugin ;
    rdfs:label "Hex Chain — Wah" ;
    doap:name  "Hex Chain Wah" ;
    mod:label  "Wah" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 25 ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "wah_type" ; lv2:name "Mode" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:scalePoint [ rdfs:label "Auto"  ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Fixed" ; rdf:value 1 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "freq" ; lv2:name "Freq" ;
        lv2:default 0.4 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "depth" ; lv2:name "Range" ;
        lv2:default 0.7 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "sens" ; lv2:name "Sens" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "q" ; lv2:name "Resonance" ;
        lv2:default 0.6 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ; lv2:symbol "mix" ; lv2:name "Mix" ;
        lv2:default 0.8 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 10 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] ;

    modgui:gui [
        modgui:resourcesDirectory <modgui-wah> ;
        modgui:iconTemplate <modgui-wah/icon-wah.html> ;
        modgui:stylesheet <modgui-wah/stylesheet-wah.css> ;
        modgui:screenshot <modgui-wah/screenshot-wah.png> ;
        modgui:thumbnail <modgui-wah/thumbnail-wah.png> ;
        modgui:brand "Hex Chain" ;
        modgui:label "Wah" ;
        modgui:model "mod-pedal-guitaramp-wah" ;
        modgui:port [
            lv2:index 0 ; lv2:symbol "wah_type" ; lv2:name "Mode"
        ] , [
            lv2:index 1 ; lv2:symbol "freq"     ; lv2:name "Freq"
        ] , [
            lv2:index 2 ; lv2:symbol "depth"    ; lv2:name "Range"
        ] , [
            lv2:index 3 ; lv2:symbol "sens"     ; lv2:name "Sens"
        ] , [
            lv2:index 4 ; lv2:symbol "q"        ; lv2:name "Resonance"
        ] , [
            lv2:index 5 ; lv2:symbol "mix"      ; lv2:name "Mix"
        ] , [
            lv2:index 6 ; lv2:symbol "bypass"   ; lv2:name "Bypass"
        ]
    ] .
