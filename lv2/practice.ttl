@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .

# ── Editor properties ────────────────────────────────────────────────────────
# A control port cannot carry a waveform or a drum pattern, so these travel as
# strings over the atom ports — the same mechanism the cabinet plugin uses for
# its saved rigs.

# The drum grid, as edited in the UI:
#   {"spb":16,"bars":1,"lanes":[{"i":0,"s":"x.......x......."}, ...]}
# Writing it fills the plugin's RT-safe user-pattern slot and switches the
# sequencer to it.
<https://rpowell5064.github.io/guitaramp-suite/practice#pattern>
    a lv2:Parameter ;
    rdfs:label "Drum Pattern" ;
    rdfs:range atom:String .

# Loop peak envelopes for the waveform display, pushed only when the recorded
# audio actually changes. Read-only: the UI draws it, it never writes it.
<https://rpowell5064.github.io/guitaramp-suite/practice#waveform>
    a lv2:Parameter ;
    rdfs:label "Loop Waveforms" ;
    rdfs:range atom:String .

# Live panel state (count-in, track states, playhead, loop progress). These
# also exist as output control ports for the hardware and the HMI, but
# mod-host forwards a monitored output to a web GUI far too sparsely to drive
# a count-in, so the panel reads them from here.
<https://rpowell5064.github.io/guitaramp-suite/practice#status>
    a lv2:Parameter ;
    rdfs:label "Panel State" ;
    rdfs:range atom:String .

# A .mid file to import as the drum pattern.
<https://rpowell5064.github.io/guitaramp-suite/practice#midifile>
    a lv2:Parameter ;
    rdfs:label "MIDI Groove" ;
    rdfs:range atom:Path .

# Port groups: generic-UI hosts (Zynthian) page the controls by these.
<https://rpowell5064.github.io/guitaramp-suite/practice#g_transport>
    a pg:Group ; lv2:symbol "g_transport" ; lv2:name "Transport" .
<https://rpowell5064.github.io/guitaramp-suite/practice#g_drums>
    a pg:Group ; lv2:symbol "g_drums" ; lv2:name "Drums" .
<https://rpowell5064.github.io/guitaramp-suite/practice#g_kit>
    a pg:Group ; lv2:symbol "g_kit" ; lv2:name "Kit Mix" .
<https://rpowell5064.github.io/guitaramp-suite/practice#g_voice>
    a pg:Group ; lv2:symbol "g_voice" ; lv2:name "Kit Voicing" .
<https://rpowell5064.github.io/guitaramp-suite/practice#g_loop>
    a pg:Group ; lv2:symbol "g_loop" ; lv2:name "Looper" .
<https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks>
    a pg:Group ; lv2:symbol "g_tracks" ; lv2:name "Loop Tracks" .
<https://rpowell5064.github.io/guitaramp-suite/practice#g_status>
    a pg:Group ; lv2:symbol "g_status" ; lv2:name "Status" .

<https://rpowell5064.github.io/guitaramp-suite/practice>
    a lv2:Plugin , lv2:UtilityPlugin ;
    rdfs:label "Hex Chain — Practice" ;
    doap:name  "Hex Chain Practice" ;
    # PatchStorage listing content (uploader reads the plugin-level rdfs:comment)
    rdfs:comment """Four-track looper and synthesised drum machine for practice.

A practice rig in one plugin: a four-track looper that quantises to the bar, and a drum machine whose kit is synthesised rather than sampled — so it needs no sample library and runs on a headless pedalboard.

The looper keeps a rolling pre-roll of its input, so hitting record a fraction late still gives you a loop that starts on the beat instead of one that is short by however late you were. All four tracks share one loop length, overdub with adjustable feedback, and there is one level of undo/redo.

The drum machine ships seventeen grooves from straight rock through gallop, d-beat, blast and half-time breakdowns, with swing, humanisation, a full kit mix, parallel bus compression and a room.

Its acoustic kit is resynthesised, not sampled. Every piece was analysed from real recordings into tracked partials and a noise spectrum, so the whole twelve-piece kit ships as about a megabyte of parameters instead of hundreds of megabytes of audio — and because it is generated rather than played back, every hit differs slightly, with no round-robins and no machine-gun effect.

Place it LAST in the chain, after amp and cab: the looper then records the signal you actually hear, and the drums are not run through your preamp.

Free and open source (GPL-3).""" ;
    mod:label  "Practice" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 28 ;   # 28: Play and Stop move the whole looper; every take counts in and restarts the loop AND the groove from the top; trim handles grabbable at pedalboard zoom and snapped to beats. 27: cymbal kit rebuilt (split amp/decay fit + retuned budgets for china/crash/ride/open hat). 26: state:interface IMPLEMENTED - loops and the edited drum pattern now survive a pedalboard reload (it was declared but extension_data never returned it). 25: non-destructive per-track loop trim with bar-snapping drag handles (ports 61-68). 24: cymbals re-analysed (decay fitted on a narrow filter, amplitude on a wide one) + Guitar Space ducking (port 60). 23: playhead is a shaded edge with a tab, not a hairline. 22: count clicks and shows from the press (was gated to the final bar), PLAY cue at the end, tracks 2-4 get waveforms (punch-in never bumped the version), Stop stops every track. 21: count-in starts on the press (was up to two silent bars first), Loop Length closes a take after N bars (port 59), and the dropdowns are driven by the script - mod-ui custom-select never opened, so the groove could not be changed. 20: panel state moved onto the atom channel - mod-host forwards monitored outputs to a web GUI far too sparsely to animate a count-in. 19: modgui:monitoredOutputs declared - mod-ui never pushes an output port to a custom GUI unless the GUI names it, so every live readout was frozen. 18: a bar of count-in (clicks + on-screen countdown) before the take that sets the loop; ports 57-58. 17: live port updates reach the panel again - mod-ui sends port changes as change.symbol and has no port_event, so every readout had frozen at its load value. 16: tempo is drag-settable again (mod-ui film widgets need a sprite, so the plain grip never initialised) + the sync state class was landing on the wrong element. 15: Hex Forge styling (gunmetal frame, hex-textured panels, unified toolbar, height auto), 1280 wide so an 8-bar grid never scrolls, hits drawn as velocity-height bars. 14: audio jacks added (the block had no connectors) + drag handle pinned to z-index 0 so it stops covering the controls. 13: fader dB span baked into the modgui - mod-ui start events carry only {symbol,value}, never ranges. 12: fader ranges read from the port ranges object mod-ui actually sends. 11: faders positioned in percent (measuring a hidden tab returned zero height, pinning them all to the bottom). 10: groove label driven by the plugin push, not a port echo. 9: tempo readout is a script-filled span (mod-ui writes readouts with textContent, invisible on an input). 8: modgui binds ports by literal symbol - mod-ui resolves {{#controls.N}} by lv2:index into a vector sized by the entry count, so the drum bus and tempo-sync ports were being dropped. 7: web GUI (modgui-practice) + host-tempo sync ports 55-56. mod-ui keys its modgui cache on the plugin version, so a modgui change that does not bump this is invisible on the device. 6: editor channel (atom control/notify ports 53-54 + pattern/waveform/midifile properties). 5: china, stack and rimshot added (15 instruments) + 3 grooves using them. 4: 10 modern metal / djent grooves (27 total). 3: Drum Body low shelf (port 50; bypass/enabled moved to 51/52). 2: drum bus — parallel compression + room. 1: first release
    # The worker carries the undo snapshot (a memcpy of the whole loop) off the
    # audio thread. It is OPTIONAL: without it the plugin runs normally and only
    # undo is unavailable, so a host with no worker support still loads it.
    lv2:optionalFeature lv2:hardRTCapable , work:schedule ;
    lv2:extensionData work:interface , state:interface ;

    patch:writable <https://rpowell5064.github.io/guitaramp-suite/practice#pattern> ,
                   <https://rpowell5064.github.io/guitaramp-suite/practice#midifile> ;
    patch:readable <https://rpowell5064.github.io/guitaramp-suite/practice#waveform> ,
                   <https://rpowell5064.github.io/guitaramp-suite/practice#status> ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        # Master play/stop for the drums AND the loop. Restarting always returns
        # to bar one, so the groove and the loop stay in phase.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "run" ; lv2:name "Run" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_transport> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ; lv2:symbol "tempo" ; lv2:name "Tempo" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_transport> ;
        units:unit units:bpm ;
        lv2:default 120.0 ; lv2:minimum 20.0 ; lv2:maximum 300.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "beats_per_bar" ; lv2:name "Beats / Bar" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_transport> ;
        lv2:portProperty lv2:integer ;
        lv2:default 4.0 ; lv2:minimum 1.0 ; lv2:maximum 16.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "drums_level" ; lv2:name "Drums Level" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_drums> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        # Must stay in step with hexdrums::patternTable() — 30 grooves.
        # practice_port_check.py asserts the labels and values match the
        # table exactly, so adding a groove without updating this fails.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "pattern" ; lv2:name "Pattern" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_drums> ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 29 ;
        lv2:scalePoint [ rdfs:label "Rock 8ths"       ; rdf:value 0  ] ;
        lv2:scalePoint [ rdfs:label "Rock 16ths"      ; rdf:value 1  ] ;
        lv2:scalePoint [ rdfs:label "Half-Time"       ; rdf:value 2  ] ;
        lv2:scalePoint [ rdfs:label "Double Kick"     ; rdf:value 3  ] ;
        lv2:scalePoint [ rdfs:label "Blast"           ; rdf:value 4  ] ;
        lv2:scalePoint [ rdfs:label "Bomb Blast"      ; rdf:value 5  ] ;
        lv2:scalePoint [ rdfs:label "Thrash Skank"    ; rdf:value 6  ] ;
        lv2:scalePoint [ rdfs:label "Gallop"          ; rdf:value 7  ] ;
        lv2:scalePoint [ rdfs:label "D-Beat"          ; rdf:value 8  ] ;
        lv2:scalePoint [ rdfs:label "Shuffle"         ; rdf:value 9  ] ;
        lv2:scalePoint [ rdfs:label "6/8"             ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "Ride Groove"     ; rdf:value 11 ] ;
        lv2:scalePoint [ rdfs:label "Tom Groove"      ; rdf:value 12 ] ;
        lv2:scalePoint [ rdfs:label "Breakdown"       ; rdf:value 13 ] ;
        lv2:scalePoint [ rdfs:label "Open Hat"        ; rdf:value 14 ] ;
        lv2:scalePoint [ rdfs:label "Fill Phrase"     ; rdf:value 15 ] ;
        lv2:scalePoint [ rdfs:label "Metronome"       ; rdf:value 16 ] ;
        lv2:scalePoint [ rdfs:label "Djent 7s"        ; rdf:value 17 ] ;
        lv2:scalePoint [ rdfs:label "Djent 5s"        ; rdf:value 18 ] ;
        lv2:scalePoint [ rdfs:label "Polymetric 3s"   ; rdf:value 19 ] ;
        lv2:scalePoint [ rdfs:label "Modern Half-Time" ; rdf:value 20 ] ;
        lv2:scalePoint [ rdfs:label "Linear Groove"   ; rdf:value 21 ] ;
        lv2:scalePoint [ rdfs:label "Hyperblast"      ; rdf:value 22 ] ;
        lv2:scalePoint [ rdfs:label "Gravity Blast"   ; rdf:value 23 ] ;
        lv2:scalePoint [ rdfs:label "Breakdown Chug"  ; rdf:value 24 ] ;
        lv2:scalePoint [ rdfs:label "Groove Metal"    ; rdf:value 25 ] ;
        lv2:scalePoint [ rdfs:label "Djent Bell"      ; rdf:value 26 ] ;
        lv2:scalePoint [ rdfs:label "Metalcore"       ; rdf:value 27 ] ;
        lv2:scalePoint [ rdfs:label "Stack Groove"    ; rdf:value 28 ] ;
        lv2:scalePoint [ rdfs:label "China Blast"     ; rdf:value 29 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "swing" ; lv2:name "Swing" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_drums> ;
        units:unit units:pc ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "humanize" ; lv2:name "Humanise" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_drums> ;
        units:unit units:pc ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        # Kit mix is a TRIM on the kit's voiced balance: 0 dB is "as designed",
        # not "unity gain on a raw voice".
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ; lv2:symbol "lvl_kick" ; lv2:name "Kick" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_kit> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 10 ; lv2:symbol "lvl_snare" ; lv2:name "Snare" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_kit> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 11 ; lv2:symbol "lvl_toms" ; lv2:name "Toms" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_kit> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 12 ; lv2:symbol "lvl_hats" ; lv2:name "Hats" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_kit> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 13 ; lv2:symbol "lvl_cymbals" ; lv2:name "Cymbals" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_kit> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 14 ; lv2:symbol "kick_tune" ; lv2:name "Kick Tune" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_voice> ;
        units:unit units:semitone12TET ;
        lv2:default 0.0 ; lv2:minimum -12.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 15 ; lv2:symbol "kick_decay" ; lv2:name "Kick Decay" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_voice> ;
        units:unit units:s ;
        lv2:default 0.42 ; lv2:minimum 0.05 ; lv2:maximum 1.5
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 16 ; lv2:symbol "kick_click" ; lv2:name "Kick Click" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_voice> ;
        units:unit units:pc ;
        lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 17 ; lv2:symbol "snare_tune" ; lv2:name "Snare Tune" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_voice> ;
        units:unit units:semitone12TET ;
        lv2:default 0.0 ; lv2:minimum -12.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 18 ; lv2:symbol "snare_decay" ; lv2:name "Snare Decay" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_voice> ;
        units:unit units:s ;
        lv2:default 0.20 ; lv2:minimum 0.04 ; lv2:maximum 0.8
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 19 ; lv2:symbol "snare_snappy" ; lv2:name "Snare Snappy" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_voice> ;
        units:unit units:pc ;
        lv2:default 60.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 20 ; lv2:symbol "hat_decay" ; lv2:name "Hat Decay" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_voice> ;
        units:unit units:s ;
        lv2:default 0.45 ; lv2:minimum 0.05 ; lv2:maximum 1.5
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 21 ; lv2:symbol "hat_tone" ; lv2:name "Hat Tone" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_voice> ;
        units:unit units:pc ;
        lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 22 ; lv2:symbol "loop_level" ; lv2:name "Loop Level" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        # Off = actions fire the instant you press. On = they land on the next
        # bar line, with a short window that snaps a late press back.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 23 ; lv2:symbol "loop_quantize" ; lv2:name "Quantise" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        # How much of the existing layer survives each overdub pass. 100% keeps
        # every layer forever; lower values let old layers fade out underneath.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 24 ; lv2:symbol "loop_feedback" ; lv2:name "Overdub Feedback" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        units:unit units:pc ;
        lv2:default 100.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        # The track the five transport triggers below act on.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 25 ; lv2:symbol "loop_track" ; lv2:name "Active Track" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 4 ;
        lv2:scalePoint [ rdfs:label "Track 1" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Track 2" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Track 3" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Track 4" ; rdf:value 4 ]
    ] , [
        # Triggers. Edge-detected in the plugin, so a footswitch that holds the
        # port high (as pi-Stomp MIDI-learn does) fires exactly once.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 26 ; lv2:symbol "loop_rec" ; lv2:name "Rec / Overdub" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        lv2:portProperty lv2:toggled , lv2:trigger ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 27 ; lv2:symbol "loop_play" ; lv2:name "Play" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        lv2:portProperty lv2:toggled , lv2:trigger ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 28 ; lv2:symbol "loop_stop" ; lv2:name "Stop" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        lv2:portProperty lv2:toggled , lv2:trigger ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 29 ; lv2:symbol "loop_clear" ; lv2:name "Clear" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        lv2:portProperty lv2:toggled , lv2:trigger ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 30 ; lv2:symbol "loop_undo" ; lv2:name "Undo / Redo" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        lv2:portProperty lv2:toggled , lv2:trigger ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 31 ; lv2:symbol "trk1_level" ; lv2:name "Track 1 Level" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 32 ; lv2:symbol "trk1_mute" ; lv2:name "Track 1 Mute" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 33 ; lv2:symbol "trk2_level" ; lv2:name "Track 2 Level" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 34 ; lv2:symbol "trk2_mute" ; lv2:name "Track 2 Mute" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 35 ; lv2:symbol "trk3_level" ; lv2:name "Track 3 Level" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 36 ; lv2:symbol "trk3_mute" ; lv2:name "Track 3 Mute" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 37 ; lv2:symbol "trk4_level" ; lv2:name "Track 4 Level" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 38 ; lv2:symbol "trk4_mute" ; lv2:name "Track 4 Mute" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        # Outputs: UI feedback only. The web GUI draws the loop progress ring,
        # the per-track state lamps and the sequencer playhead from these.
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 39 ; lv2:symbol "out_progress" ; lv2:name "Loop Progress" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_status> ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 40 ; lv2:symbol "out_bars" ; lv2:name "Loop Bars" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_status> ;
        lv2:portProperty lv2:integer ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 512.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 41 ; lv2:symbol "out_trk1_state" ; lv2:name "Track 1 State" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_status> ;
        lv2:portProperty lv2:integer ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 42 ; lv2:symbol "out_trk2_state" ; lv2:name "Track 2 State" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_status> ;
        lv2:portProperty lv2:integer ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 43 ; lv2:symbol "out_trk3_state" ; lv2:name "Track 3 State" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_status> ;
        lv2:portProperty lv2:integer ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 44 ; lv2:symbol "out_trk4_state" ; lv2:name "Track 4 State" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_status> ;
        lv2:portProperty lv2:integer ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 45 ; lv2:symbol "out_step" ; lv2:name "Playhead Step" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_status> ;
        lv2:portProperty lv2:integer ;
        lv2:default -1.0 ; lv2:minimum -1.0 ; lv2:maximum 63.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 46 ; lv2:symbol "out_undo_avail" ; lv2:name "Undo Available" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_status> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        # ── Drum bus ────────────────────────────────────────────────────────
        # Parallel compression: a hard-crushed copy of the kit blended under
        # the untouched dry. Series bus compression measured useless here —
        # the kit has a 22 dB crest factor, so any threshold that catches the
        # peaks never touches the body, and one that catches the body ducks it
        # while missing the peaks. Parallel raises density with the transients
        # intact, and because the knob is a blend rather than a threshold it
        # behaves the same at any gain staging.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 47 ; lv2:symbol "drum_comp" ; lv2:name "Drum Comp" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_drums> ;
        units:unit units:pc ;
        lv2:default 35.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        # The kit is analysed from CLOSE mics only, on purpose: overhead bleed
        # would have put one instrument's partials into another's model. That
        # leaves it accurate and completely dry, so the room a real kit is
        # played in has to be restored here — over the whole kit at once, which
        # is how a room actually works.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 48 ; lv2:symbol "drum_room" ; lv2:name "Drum Room" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_drums> ;
        units:unit units:pc ;
        lv2:default 30.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 49 ; lv2:symbol "drum_room_size" ; lv2:name "Room Size" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_drums> ;
        units:unit units:pc ;
        lv2:default 35.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        # Weight for the kick and low toms. A low SHELF at 90 Hz, not a
        # resonant boost: a shelf is minimum-phase with a short impulse
        # response, so it raises the low end already present without adding
        # decay. A resonance at 60-90 Hz would ring, and that ringing is
        # exactly what smears consecutive double-kick strokes together.
        # 90 Hz sits above the kick's 47-60 Hz fundamental so it lifts body
        # rather than sub-rumble, and below the snare's ~185 Hz shell.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 50 ; lv2:symbol "drum_body" ; lv2:name "Drum Body" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_drums> ;
        units:unit units:pc ;
        lv2:default 30.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0
    ] , [
        # Silences the drums and the loop; the dry guitar still passes, because
        # this plugin sits last in the chain and muting it would mute the rig.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 51 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        # Host block-enable, designated per the LV2 spec so generic-UI hosts
        # (Zynthian, MOD, KosmOS) bind it as the bypass switch. NOTE the sense
        # is INVERTED relative to "bypass": 1 = processing on, 0 = bypassed.
        # Deliberately ungrouped and last.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 52 ; lv2:symbol "enabled" ; lv2:name "Enabled" ;
        lv2:designation lv2:enabled ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        # Editor channel. APPENDED AFTER `enabled` deliberately: this plugin's
        # ports have been renumbered three times and every renumber invalidates
        # saved pedalboards and MIDI bindings. New ports go on the end from
        # here on. A host binds the lv2:enabled DESIGNATION, not its position.
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:index 53 ; lv2:symbol "control" ; lv2:name "Control" ;
        lv2:designation lv2:control
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:index 54 ; lv2:symbol "notify" ; lv2:name "Notify" ;
        lv2:designation lv2:control
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 55 ; lv2:symbol "tempo_sync" ; lv2:name "Sync To Host" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_transport> ;
        rdfs:comment "Follow the host's transport tempo instead of the Tempo knob."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 56 ; lv2:symbol "host_bpm" ; lv2:name "Host BPM" ;
        lv2:designation time:beatsPerMinute ;
        lv2:default 120.0 ; lv2:minimum 20.0 ; lv2:maximum 300.0 ;
        units:unit units:bpm ;
        rdfs:comment "Written by the host with the global transport tempo; read only when Sync To Host is on."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 57 ; lv2:symbol "count_in" ; lv2:name "Count In" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        rdfs:comment "Count a bar of clicks in before the take that sets the loop length."
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 58 ; lv2:symbol "out_countin" ; lv2:name "Count In Beats" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 16 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_status> ;
        rdfs:comment "Beats remaining on the count-in; 0 when not counting."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 59 ; lv2:symbol "loop_bars" ; lv2:name "Loop Length" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 32 ;
        lv2:scalePoint [ rdfs:label "Free"     ; rdf:value 0  ] ;
        lv2:scalePoint [ rdfs:label "1 bar"    ; rdf:value 1  ] ;
        lv2:scalePoint [ rdfs:label "2 bars"   ; rdf:value 2  ] ;
        lv2:scalePoint [ rdfs:label "4 bars"   ; rdf:value 4  ] ;
        lv2:scalePoint [ rdfs:label "8 bars"   ; rdf:value 8  ] ;
        lv2:scalePoint [ rdfs:label "12 bars"  ; rdf:value 12 ] ;
        lv2:scalePoint [ rdfs:label "16 bars"  ; rdf:value 16 ] ;
        lv2:scalePoint [ rdfs:label "24 bars"  ; rdf:value 24 ] ;
        lv2:scalePoint [ rdfs:label "32 bars"  ; rdf:value 32 ] ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_loop> ;
        rdfs:comment "Close the take automatically after this many bars; Free records until you press again."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 60 ; lv2:symbol "drum_space" ; lv2:name "Guitar Space" ;
        units:unit units:pc ;
        lv2:default 40.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_drums> ;
        rdfs:comment "Ducks the kit's low mids while the guitar is using that band, so the two stop masking each other. Only acts while you play."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 61 ; lv2:symbol "trk1_trim_in" ; lv2:name "Track 1 Trim In" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        rdfs:comment "Start of track 1's trim window, as a fraction of the loop. Non-destructive."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 62 ; lv2:symbol "trk1_trim_out" ; lv2:name "Track 1 Trim Out" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        rdfs:comment "End of track 1's trim window, as a fraction of the loop. Non-destructive."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 63 ; lv2:symbol "trk2_trim_in" ; lv2:name "Track 2 Trim In" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        rdfs:comment "Start of track 2's trim window, as a fraction of the loop. Non-destructive."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 64 ; lv2:symbol "trk2_trim_out" ; lv2:name "Track 2 Trim Out" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        rdfs:comment "End of track 2's trim window, as a fraction of the loop. Non-destructive."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 65 ; lv2:symbol "trk3_trim_in" ; lv2:name "Track 3 Trim In" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        rdfs:comment "Start of track 3's trim window, as a fraction of the loop. Non-destructive."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 66 ; lv2:symbol "trk3_trim_out" ; lv2:name "Track 3 Trim Out" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        rdfs:comment "End of track 3's trim window, as a fraction of the loop. Non-destructive."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 67 ; lv2:symbol "trk4_trim_in" ; lv2:name "Track 4 Trim In" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        rdfs:comment "Start of track 4's trim window, as a fraction of the loop. Non-destructive."
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 68 ; lv2:symbol "trk4_trim_out" ; lv2:name "Track 4 Trim Out" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/practice#g_tracks> ;
        rdfs:comment "End of track 4's trim window, as a fraction of the loop. Non-destructive."
    ] ;

    # ── Custom MOD web GUI ────────────────────────────────────────────────────
    # A work surface rather than a faceplate: the loop waveforms and the drum
    # step grid are canvases, and they travel over the atom ports as JSON
    # because a control port cannot carry either.
    #
    # HOW modgui:port ACTUALLY WORKS (verified against mod-ui on the device,
    # 2026-09-30 -- do not "tidy" this without re-checking):
    # mod-ui's native parser assigns each entry below AT ITS lv2:index into a
    # vector whose LENGTH IS THE NUMBER OF ENTRIES, then the icon template's
    # {{#controls.N}} resolves to element N of that vector. So:
    #   * N is the port's lv2:index, NOT its position in this list;
    #   * any entry whose lv2:index >= the entry count is SILENTLY DROPPED;
    #   * indices belonging to non-declared ports come back as blank entries.
    # That last two points bit this panel: with 43 entries declared, the drum
    # bus (47-50) and the host-tempo ports (55-56) vanished from the template.
    #
    # The template therefore binds almost everything by a LITERAL
    # mod-port-symbol, which mod-ui resolves at runtime from the plugin's own
    # port list and which no amount of index drift can break. The sole
    # {{#controls.N}} left is the groove dropdown (index 6), which needs
    # {{#scalePoints}} to emit its 30 rows -- keeping that list here, where
    # practice_port_check.py already gates it against DrumPatterns.h, beats
    # copying 30 groove names into the HTML as a third source of truth.
    modgui:gui [
        modgui:resourcesDirectory <modgui-practice> ;
        modgui:iconTemplate <modgui-practice/icon-practice.html> ;
        modgui:stylesheet <modgui-practice/stylesheet-practice.css> ;
        modgui:javascript <modgui-practice/script-practice.js> ;
        modgui:screenshot <modgui-practice/screenshot-practice.png> ;
        modgui:thumbnail <modgui-practice/thumbnail-practice.png> ;
        modgui:brand "Hex Chain" ;
        modgui:label "Practice" ;
        modgui:model "mod-pedal-guitaramp-practice" ;
        # Output ports the panel reads. mod-ui pushes an output port to the GUI
        # ONLY if it is named here -- an unlisted one is never monitored and the
        # JS never sees it, which is how every live readout on this panel came
        # to be frozen while nothing appeared to be wrong.
        modgui:monitoredOutputs [ lv2:symbol "out_progress" ] , [ lv2:symbol "out_bars" ] , [ lv2:symbol "out_trk1_state" ] , [ lv2:symbol "out_trk2_state" ] , [ lv2:symbol "out_trk3_state" ] , [ lv2:symbol "out_trk4_state" ] , [ lv2:symbol "out_step" ] , [ lv2:symbol "out_undo_avail" ] , [ lv2:symbol "out_countin" ] ;
        modgui:port [
            lv2:index 2 ; lv2:symbol "run" ; lv2:name "Run"
        ] , [
            lv2:index 3 ; lv2:symbol "tempo" ; lv2:name "Tempo"
        ] , [
            lv2:index 4 ; lv2:symbol "beats_per_bar" ; lv2:name "Beats / Bar"
        ] , [
            lv2:index 5 ; lv2:symbol "drums_level" ; lv2:name "Drums Level"
        ] , [
            lv2:index 6 ; lv2:symbol "pattern" ; lv2:name "Pattern"
        ] , [
            lv2:index 7 ; lv2:symbol "swing" ; lv2:name "Swing"
        ] , [
            lv2:index 8 ; lv2:symbol "humanize" ; lv2:name "Humanise"
        ] , [
            lv2:index 9 ; lv2:symbol "lvl_kick" ; lv2:name "Kick"
        ] , [
            lv2:index 10 ; lv2:symbol "lvl_snare" ; lv2:name "Snare"
        ] , [
            lv2:index 11 ; lv2:symbol "lvl_toms" ; lv2:name "Toms"
        ] , [
            lv2:index 12 ; lv2:symbol "lvl_hats" ; lv2:name "Hats"
        ] , [
            lv2:index 13 ; lv2:symbol "lvl_cymbals" ; lv2:name "Cymbals"
        ] , [
            lv2:index 14 ; lv2:symbol "kick_tune" ; lv2:name "Kick Tune"
        ] , [
            lv2:index 15 ; lv2:symbol "kick_decay" ; lv2:name "Kick Decay"
        ] , [
            lv2:index 16 ; lv2:symbol "kick_click" ; lv2:name "Kick Click"
        ] , [
            lv2:index 17 ; lv2:symbol "snare_tune" ; lv2:name "Snare Tune"
        ] , [
            lv2:index 18 ; lv2:symbol "snare_decay" ; lv2:name "Snare Decay"
        ] , [
            lv2:index 19 ; lv2:symbol "snare_snappy" ; lv2:name "Snare Snappy"
        ] , [
            lv2:index 20 ; lv2:symbol "hat_decay" ; lv2:name "Hat Decay"
        ] , [
            lv2:index 21 ; lv2:symbol "hat_tone" ; lv2:name "Hat Tone"
        ] , [
            lv2:index 22 ; lv2:symbol "loop_level" ; lv2:name "Loop Level"
        ] , [
            lv2:index 23 ; lv2:symbol "loop_quantize" ; lv2:name "Quantise"
        ] , [
            lv2:index 24 ; lv2:symbol "loop_feedback" ; lv2:name "Overdub Feedback"
        ] , [
            lv2:index 25 ; lv2:symbol "loop_track" ; lv2:name "Active Track"
        ] , [
            lv2:index 26 ; lv2:symbol "loop_rec" ; lv2:name "Rec / Overdub"
        ] , [
            lv2:index 27 ; lv2:symbol "loop_play" ; lv2:name "Play"
        ] , [
            lv2:index 28 ; lv2:symbol "loop_stop" ; lv2:name "Stop"
        ] , [
            lv2:index 29 ; lv2:symbol "loop_clear" ; lv2:name "Clear"
        ] , [
            lv2:index 30 ; lv2:symbol "loop_undo" ; lv2:name "Undo / Redo"
        ] , [
            lv2:index 31 ; lv2:symbol "trk1_level" ; lv2:name "Track 1 Level"
        ] , [
            lv2:index 32 ; lv2:symbol "trk1_mute" ; lv2:name "Track 1 Mute"
        ] , [
            lv2:index 33 ; lv2:symbol "trk2_level" ; lv2:name "Track 2 Level"
        ] , [
            lv2:index 34 ; lv2:symbol "trk2_mute" ; lv2:name "Track 2 Mute"
        ] , [
            lv2:index 35 ; lv2:symbol "trk3_level" ; lv2:name "Track 3 Level"
        ] , [
            lv2:index 36 ; lv2:symbol "trk3_mute" ; lv2:name "Track 3 Mute"
        ] , [
            lv2:index 37 ; lv2:symbol "trk4_level" ; lv2:name "Track 4 Level"
        ] , [
            lv2:index 38 ; lv2:symbol "trk4_mute" ; lv2:name "Track 4 Mute"
        ] , [
            lv2:index 47 ; lv2:symbol "drum_comp" ; lv2:name "Drum Comp"
        ] , [
            lv2:index 48 ; lv2:symbol "drum_room" ; lv2:name "Drum Room"
        ] , [
            lv2:index 49 ; lv2:symbol "drum_room_size" ; lv2:name "Room Size"
        ] , [
            lv2:index 50 ; lv2:symbol "drum_body" ; lv2:name "Drum Body"
        ] , [
            lv2:index 51 ; lv2:symbol "bypass" ; lv2:name "Bypass"
        ] , [
            lv2:index 52 ; lv2:symbol "enabled" ; lv2:name "Enabled"
        ] , [
            lv2:index 55 ; lv2:symbol "tempo_sync" ; lv2:name "Sync To Host"
        ] , [
            lv2:index 56 ; lv2:symbol "host_bpm" ; lv2:name "Host BPM"
        ] , [
