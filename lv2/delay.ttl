@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<https://rpowell5064.github.io/guitaramp-suite/delay>
    a lv2:Plugin, lv2:DelayPlugin ;
    rdfs:label "Hex Chain — Delay" ;
    doap:name  "Hex Chain Delay" ;
    mod:label  "Delay" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 3 ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "delay_type" ; lv2:name "Type" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:scalePoint [ rdfs:label "Digital" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Tape"    ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Echo Wreck" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Seraph" ; rdf:value 3 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "time_ms" ; lv2:name "Time" ;
        units:unit units:ms ;
        lv2:default 250.0 ; lv2:minimum 1.0 ; lv2:maximum 2000.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "feedback" ; lv2:name "Feedback" ;
        lv2:default 0.4 ; lv2:minimum 0.0 ; lv2:maximum 0.98
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "mix" ; lv2:name "Mix" ;
        lv2:default 0.3 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "stereo_width" ; lv2:name "Width" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ; lv2:symbol "wow_depth" ; lv2:name "Wow" ;
        lv2:default 0.003 ; lv2:minimum 0.0 ; lv2:maximum 0.05
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 10 ; lv2:symbol "flutter_depth" ; lv2:name "Flutter" ;
        lv2:default 0.001 ; lv2:minimum 0.0 ; lv2:maximum 0.02
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 11 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 12 ; lv2:symbol "heads" ; lv2:name "Heads" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 10 ; lv2:minimum 0 ; lv2:maximum 11 ;
        # Binson Echorec rotary: which playback heads fire. Ignored by Digital/Tape.
        lv2:scalePoint [ rdfs:label "1: Head 1"       ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "2: Head 2"       ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "3: Head 3"       ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "4: Head 4"       ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "5: Heads 1+2"    ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "6: Heads 2+3"    ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "7: Heads 3+4"    ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "8: Heads 1+2+3"  ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "9: Heads 2+3+4"  ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "10: Heads 1+3+4" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "11: All Heads"   ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "12: All + Dense" ; rdf:value 11 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 13 ; lv2:symbol "pattern" ; lv2:name "Pattern" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 3 ;
        # Seraph: engine-B delay as a rhythmic ratio of engine-A. Ignored by others.
        lv2:scalePoint [ rdfs:label "Unison"     ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Dotted 8th" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Triplet"    ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Eighth"     ; rdf:value 3 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 14 ; lv2:symbol "ducking" ; lv2:name "Ducking" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 15 ; lv2:symbol "mod_depth" ; lv2:name "Mod Depth" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 16 ; lv2:symbol "mod_rate" ; lv2:name "Mod Rate" ;
        lv2:default 0.3 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] ;

    # ── Custom MOD web GUI ────────────────────────────────────────────────────
    # Wow + Flutter (tape motion) are shown only for Tape / Echorec — see
    # script-delay.js. The DSP applies all params regardless, so this is cosmetic.
    modgui:gui [
        modgui:resourcesDirectory <modgui-delay> ;
        modgui:iconTemplate <modgui-delay/icon-delay.html> ;
        modgui:stylesheet <modgui-delay/stylesheet-delay.css> ;
        modgui:javascript <modgui-delay/script-delay.js> ;
        modgui:screenshot <modgui-delay/screenshot-delay.png> ;
        modgui:thumbnail <modgui-delay/thumbnail-delay.png> ;
        modgui:brand "Hex Chain" ;
        modgui:label "Delay" ;
        modgui:model "mod-pedal-guitaramp-delay" ;
        modgui:port [
            lv2:index 0 ; lv2:symbol "delay_type"    ; lv2:name "Type"
        ] , [
            lv2:index 1 ; lv2:symbol "time_ms"       ; lv2:name "Time"
        ] , [
            lv2:index 2 ; lv2:symbol "feedback"      ; lv2:name "Feedback"
        ] , [
            lv2:index 3 ; lv2:symbol "mix"           ; lv2:name "Mix"
        ] , [
            lv2:index 4 ; lv2:symbol "stereo_width"  ; lv2:name "Width"
        ] , [
            lv2:index 5 ; lv2:symbol "wow_depth"     ; lv2:name "Wow"
        ] , [
            lv2:index 6 ; lv2:symbol "flutter_depth" ; lv2:name "Flutter"
        ] , [
            lv2:index 7 ; lv2:symbol "bypass"        ; lv2:name "Bypass"
        ] , [
            lv2:index 8 ; lv2:symbol "heads"         ; lv2:name "Heads"
        ] , [
            lv2:index 9 ; lv2:symbol "pattern"       ; lv2:name "Pattern"
        ] , [
            lv2:index 10 ; lv2:symbol "ducking"      ; lv2:name "Ducking"
        ] , [
            lv2:index 11 ; lv2:symbol "mod_depth"    ; lv2:name "Mod Depth"
        ] , [
            lv2:index 12 ; lv2:symbol "mod_rate"     ; lv2:name "Mod Rate"
        ]
    ] .
