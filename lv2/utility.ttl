@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

# Port groups: generic-UI hosts (Zynthian) page the controls by these.
<https://rpowell5064.github.io/guitaramp-suite/utility#g_input>
    a pg:Group ; lv2:symbol "g_input" ; lv2:name "Input" .
<https://rpowell5064.github.io/guitaramp-suite/utility#g_pickup>
    a pg:Group ; lv2:symbol "g_pickup" ; lv2:name "Pickup Voicing" .

<https://rpowell5064.github.io/guitaramp-suite/utility>
    a lv2:Plugin, lv2:UtilityPlugin ;
    rdfs:label "Hex Chain — Input Trim" ;
    doap:name  "Hex Chain Input Trim" ;
    # PatchStorage listing content (uploader reads the plugin-level rdfs:comment)
    rdfs:comment """Gain / phase / hum-filter + single-coil→humbucker voicing.

A small but handy front-of-chain utility: clean gain trim, phase invert, a mains-hum filter (a comb of notches on the mains frequency and its harmonics, switchable 50 or 60 Hz for your region), and a single-coil→humbucker voicing. The voicing re-voices a single-coil pickup toward one of three target bridge humbuckers — '59 Bucker (warm late-'50s vintage), Norse Hammer (hot ceramic) or Modern Flux (active hi-fi) — with an Amount control (0 = bypass). Minimal CPU; runs on every target.

Free and open source (GPL-3).""" ;
    mod:label  "Input Trim" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 2 ;
    lv2:microVersion 39 ;   # 39: GUITAR Default leaves the Gain (input volume) as set instead of writing 0 dB (it is re-applied on recall). 38: the GUITAR selector WRITES the controls (Gain, Humbucker, HB Model, HB Amount) so what it does is visible; HB Model gains "Hot -> PAF" (3); the hidden guitar layer is gone (2026-10-06).   # 37: the GUITAR selector reads Single Coil (was Telecaster) and the panel spells out what each choice applies under it (2026-10-06).   # 36: GUITAR preset selector (Default / Telecaster / Hot Pickups), appended after the enabled port (2026-10-05)   # 35: lv2:enabled block-enable port added at the END (designated so generic-UI hosts can bind it as the bypass; INVERTED sense, 1 = on). The existing bypass port is unmoved: renumbering it would shift every port after it and invalidate saved boards. 34: Input Trim humbucker voicing was INAUDIBLE out of the box — hb_amount defaulted to 0.0 (a true bypass) while the Humbucker toggle defaulted ON, so neither the toggle nor HB Model did anything. Now toggle-off / amount-1.0, matching Hex Forge. 33: MAINS selector (60 / 50 Hz) for the hum comb, port 11, default 60 = bit-identical. 32: LV2 port groups (generic-UI hosts like Zynthian page the controls by these; metadata only)
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "gain_db" ; lv2:name "Gain" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_input> ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -20.0 ; lv2:maximum 20.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ; lv2:symbol "phase_invert" ; lv2:name "Phase" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_input> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "hum_filter" ; lv2:name "Hum Filter" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_input> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "hb_model" ; lv2:name "HB Model" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_pickup> ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:scalePoint [ rdfs:label "'59 Bucker"   ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Norse Hammer" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Modern Flux"  ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Hot → PAF"  ; rdf:value 3 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "hb_amount" ; lv2:name "HB Amount" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_pickup> ;
        # Default 1.0 (= 100 %) since microVersion 34.  It was 0.0, which is a true
        # bypass, so the Humbucker toggle below (which defaulted ON) had nothing to
        # scale and the voicing was inaudible no matter what the toggle or HB Model
        # were set to.  Hex Forge's Input Trim has always been toggle-off/amount-1.0;
        # these now match.  Saved boards keep their stored values and are unaffected.
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "humbucker" ; lv2:name "Humbucker" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_pickup> ;
        lv2:portProperty lv2:toggled ;
        # Default OFF since microVersion 34, matching Hex Forge: the voicing is
        # calibrated FROM a single-coil bridge pickup, so it mis-corrects a guitar
        # that already has humbuckers and must be opt-in.
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "boost" ; lv2:name "Boost" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_pickup> ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ; lv2:symbol "boost_amt" ; lv2:name "Boost Amt" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_pickup> ;
        units:unit units:db ;
        lv2:default 4.0 ; lv2:minimum 0.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 10 ; lv2:symbol "pickup_load" ; lv2:name "Pickup Load" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_input> ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        # Mains frequency (2026-09-25): the hum comb's harmonic series, 60 Hz (Americas,
        # Japan east) or 50 Hz (Europe, most of the world).
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 11 ; lv2:symbol "mains" ; lv2:name "Mains" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_input> ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:scalePoint [ rdfs:label "60 Hz" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "50 Hz" ; rdf:value 1 ]
    ] , [
        # Host block-enable, designated per the LV2 spec so generic-UI hosts
        # (Zynthian, MOD, KosmOS) can bind it as the plugin's bypass switch
        # instead of listing it as an ordinary parameter.  NOTE the sense is
        # INVERTED relative to the "bypass" port: enabled 1 = processing on,
        # 0 = bypassed.  Deliberately ungrouped and last, so a host that
        # ignores the designation still shows it at the END of the list.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 12 ; lv2:symbol "enabled" ; lv2:name "Enabled" ;
        lv2:designation lv2:enabled ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        # GUITAR preset (2026-10-05): which instrument is plugged in. Since 2026-10-06 the PANEL
        # writes this plugin's own controls for it -- 0 Default = Humbucker off, Gain 0;
        # 1 Single Coil = Humbucker on, '59 Bucker 100 %, Gain +2 dB; 2 Hot Pickups = Humbucker
        # on, "Hot -> PAF" 100 %, Gain -4 dB -- so what it does is visible on the knobs; the
        # plugin runs no layer of its own for it. Appended after the enabled port.
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 13 ; lv2:symbol "guitar" ; lv2:name "Guitar" ;
        pg:group <https://rpowell5064.github.io/guitaramp-suite/utility#g_input> ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:scalePoint [ rdfs:label "Default" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Single Coil" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Hot Pickups" ; rdf:value 2 ]
    ] ;

    modgui:gui [
        modgui:resourcesDirectory <modgui-utility> ;
        modgui:iconTemplate <modgui-utility/icon-utility.html> ;
        modgui:javascript <modgui-utility/script-utility.js> ;
        modgui:stylesheet <modgui-utility/stylesheet-utility.css> ;
        modgui:screenshot <modgui-utility/screenshot-utility.png> ;
        modgui:thumbnail <modgui-utility/thumbnail-utility.png> ;
        modgui:brand "Hex Chain" ;
        modgui:label "Input Trim" ;
        modgui:model "mod-pedal-guitaramp-utility" ;
        modgui:port [
            lv2:index 0 ; lv2:symbol "gain_db"      ; lv2:name "Gain"
        ] , [
            lv2:index 1 ; lv2:symbol "phase_invert" ; lv2:name "Phase"
        ] , [
            lv2:index 2 ; lv2:symbol "hum_filter"   ; lv2:name "Hum Filter"
        ] , [
            lv2:index 3 ; lv2:symbol "hb_model"     ; lv2:name "HB Model"
        ] , [
            lv2:index 4 ; lv2:symbol "hb_amount"    ; lv2:name "HB Amount"
        ] , [
            lv2:index 5 ; lv2:symbol "humbucker"    ; lv2:name "Humbucker"
        ] , [
            lv2:index 6 ; lv2:symbol "boost"        ; lv2:name "Boost"
        ] , [
            lv2:index 7 ; lv2:symbol "boost_amt"    ; lv2:name "Boost Amt"
        ] , [
            lv2:index 8 ; lv2:symbol "pickup_load"  ; lv2:name "Pickup Load"
        ] , [
            lv2:index 9 ; lv2:symbol "mains"        ; lv2:name "Mains"
        ] , [
            lv2:index 10 ; lv2:symbol "guitar"      ; lv2:name "Guitar"
        ]
    ] .
