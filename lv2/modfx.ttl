@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://rpowell5064.github.io/guitaramp-suite/modfx>
    a lv2:Plugin, lv2:ModulatorPlugin ;
    rdfs:label "Hex Chain — Modulation" ;
    doap:name  "Hex Chain Modulation" ;
    # PatchStorage listing content (uploader reads the plugin-level rdfs:comment)
    rdfs:comment """Nine modulations in one block: two choruses, vibe, seasick tape-warble, two phasers, flanger, tremolo, rotary.

A modulation block with NINE voicings:

- Lush-2 — warm bucket-brigade-style analog chorus
- Uni-Verse — throbbing photocell swirl for your inner '69
- Phaser — classic four-stage swoosh, slow haze to fast ripple
- Flanger — metallic jet sweep with feedback
- Tremolo — amplitude pulse, gentle shimmer to hard square chop
- Rotary — a spinning-speaker doppler swirl
- Nevermind Chorus — the watery, seasick analog chorus that defined a certain 1991 intro
- Seasick Vibe — a deep tape-warble that genuinely heaves in pitch: an extended sweep range, slow two-sine tape drift, and a true dry/wet crossfade so the queasiness comes through instead of averaging out
- Script Phaser — a smooth, feedback-free four-stage script-era phaser: a pure sine sweep and soft, musical notches, warmer and rounder than the resonant block-voiced Phaser

A Center Delay control (0–100 ms) shifts the delay line the chorus/flanger modulates around — from tight comb-filter shimmer to wide doubling. Level-safe wet/dry handling means engaging it never drops your volume. Light on CPU; runs on every target including 32-bit Pi.

Works standalone or as part of the Hex Chain suite / Hex Forge. Free and open source (GPL-3).""" ;
    mod:label  "Modulation" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 36 ;   # 34: version bump to re-list on PatchStorage so the listing description publishes (was missing). 33: Script Phaser type 8 (script-era P90, no feedback)
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "mod_type" ; lv2:name "Type" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 8 ;
        lv2:scalePoint [ rdfs:label "Lush-2"          ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Uni-Verse"       ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Phaser"          ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Flanger"         ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Tremolo"         ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Rotary"          ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "Nevermind Chorus" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "Seasick Vibe" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "Script Phaser" ; rdf:value 8 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "rate" ; lv2:name "Rate" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "depth" ; lv2:name "Depth" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "mix" ; lv2:name "Mix" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "stereo_width" ; lv2:name "Width" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 10 ; lv2:symbol "offset" ; lv2:name "Center Delay" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 100.0 ;
        units:unit units:ms ;
        rdfs:comment "Delay the modulation centre by 0–100 ms (chorus/flanger/small-clone only; 0 = stock voicing)."
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 11 ; lv2:symbol "shape" ; lv2:name "Shape" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:scalePoint [ rdfs:label "Bias"     ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Opto"     ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Harmonic" ; rdf:value 2 ] ;
        rdfs:comment "Tremolo waveform: Bias (classic sine), Opto (hard photocell chop), Harmonic (brownface phase-split). Tremolo only."
    ] ;

    modgui:gui [
        modgui:resourcesDirectory <modgui-modfx> ;
        modgui:iconTemplate <modgui-modfx/icon-modfx.html> ;
        modgui:stylesheet <modgui-modfx/stylesheet-modfx.css> ;
        modgui:javascript <modgui-modfx/script-modfx.js> ;
        modgui:screenshot <modgui-modfx/screenshot-modfx.png> ;
        modgui:thumbnail <modgui-modfx/thumbnail-modfx.png> ;
        modgui:brand "Hex Chain" ;
        modgui:label "Modulation" ;
        modgui:model "mod-pedal-guitaramp-modfx" ;
        modgui:port [
            lv2:index 0 ; lv2:symbol "mod_type"     ; lv2:name "Type"
        ] , [
            lv2:index 1 ; lv2:symbol "rate"         ; lv2:name "Rate"
        ] , [
            lv2:index 2 ; lv2:symbol "depth"        ; lv2:name "Depth"
        ] , [
            lv2:index 3 ; lv2:symbol "mix"          ; lv2:name "Mix"
        ] , [
            lv2:index 4 ; lv2:symbol "stereo_width" ; lv2:name "Width"
        ] , [
            lv2:index 5 ; lv2:symbol "bypass"       ; lv2:name "Bypass"
        ] , [
            lv2:index 6 ; lv2:symbol "offset"       ; lv2:name "Center Delay"
        ] , [
            lv2:index 7 ; lv2:symbol "shape"        ; lv2:name "Shape"
        ]
    ] .
