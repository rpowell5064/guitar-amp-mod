@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<https://rpowell5064.github.io/guitaramp-suite/nail>
    a lv2:Plugin, lv2:DistortionPlugin ;
    rdfs:label "Hex Chain — Nail" ;
    doap:name  "Hex Chain Nail" ;
    mod:label  "Nail" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 24 ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "mode" ; lv2:name "Mode" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 4 ;
        lv2:scalePoint [ rdfs:label "Broke"      ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Dahnward"   ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Delicate"   ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Con Molars"     ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Yo, Hey Adrian!" ; rdf:value 4 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ; lv2:symbol "drive" ; lv2:name "Drive" ;
        lv2:default 0.55 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "filter" ; lv2:name "Filter" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "texture" ; lv2:name "Texture" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 0.65 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "ring" ; lv2:name "Ring Mod" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] ;

    # ── Custom MOD web GUI ────────────────────────────────────────────────────
    modgui:gui [
        modgui:resourcesDirectory <modgui-nail> ;
        modgui:iconTemplate <modgui-nail/icon-nail.html> ;
        modgui:stylesheet <modgui-nail/stylesheet-nail.css> ;
        modgui:javascript <modgui-nail/script-nail.js> ;
        modgui:screenshot <modgui-nail/screenshot-nail.png> ;
        modgui:thumbnail <modgui-nail/thumbnail-nail.png> ;
        modgui:brand "Hex Chain" ;
        modgui:label "Nail" ;
        modgui:model "mod-pedal-guitaramp-nail" ;
        modgui:port [
            lv2:index 0 ; lv2:symbol "mode"    ; lv2:name "Mode"
        ] , [
            lv2:index 1 ; lv2:symbol "drive"   ; lv2:name "Drive"
        ] , [
            lv2:index 2 ; lv2:symbol "filter"  ; lv2:name "Filter"
        ] , [
            lv2:index 3 ; lv2:symbol "texture" ; lv2:name "Texture"
        ] , [
            lv2:index 4 ; lv2:symbol "level"   ; lv2:name "Level"
        ] , [
            lv2:index 5 ; lv2:symbol "ring"    ; lv2:name "Ring Mod"
        ] , [
            lv2:index 6 ; lv2:symbol "bypass"  ; lv2:name "Bypass"
        ]
    ] .
