@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix time:  <http://lv2plug.in/ns/ext/time#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix pprops:<http://lv2plug.in/ns/ext/port-props#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

# ── Cabinet IR file parameter (same as the standalone Cab) ───────────────────
<https://rpowell5064.github.io/guitaramp-suite/hexforge#irfile>
    a lv2:Parameter ;
    rdfs:label "Cabinet IR" ;
    rdfs:range atom:Path ;
    mod:fileTypes "cabsim,ir,wav,audio" .

# NAM neural-capture file params (Amp slot 5 / Drive slot 3 / Cab dual-mode).
<https://rpowell5064.github.io/guitaramp-suite/hexforge#ampnam>
    a lv2:Parameter ;
    rdfs:label "Amp NAM" ;
    rdfs:range atom:Path ;
    mod:fileTypes "nammodel,nam" .

<https://rpowell5064.github.io/guitaramp-suite/hexforge#drnam>
    a lv2:Parameter ;
    rdfs:label "Drive NAM" ;
    rdfs:range atom:Path ;
    mod:fileTypes "nammodel,nam" .

<https://rpowell5064.github.io/guitaramp-suite/hexforge#cabnam>
    a lv2:Parameter ;
    rdfs:label "Cabinet NAM" ;
    rdfs:range atom:Path ;
    mod:fileTypes "nammodel,nam" .

# Preset-engine string params. The plugin owns the 8x4 preset store in
# State; these carry only small status/command strings over the atom ports.
#   ps_name  : UI<->plugin — renames the active preset.
#   ps_index : plugin->UI — "bank|slot|name0|..|name31" for the list.
#   ps_apply : plugin->UI — "sym=val;.." snapshot so the UI re-syncs knobs.
# Declared writable so mod-ui delivers their patch:Set notify messages to the
# custom modgui exactly like the file-picker params (alphabetical indices:
# ampnam=0 cabnam=1 drnam=2 irfile=3 meters=4 ps_apply=5 ps_index=6 ps_name=7).
<https://rpowell5064.github.io/guitaramp-suite/hexforge#ps_name>
    a lv2:Parameter ;
    rdfs:label "Preset Name" ;
    rdfs:range atom:String .

<https://rpowell5064.github.io/guitaramp-suite/hexforge#ps_index>
    a lv2:Parameter ;
    rdfs:label "Preset Index" ;
    rdfs:range atom:String .

<https://rpowell5064.github.io/guitaramp-suite/hexforge#ps_apply>
    a lv2:Parameter ;
    rdfs:label "Preset Apply" ;
    rdfs:range atom:String .

<https://rpowell5064.github.io/guitaramp-suite/hexforge#meters>
    a lv2:Parameter ;
    rdfs:label "Level Meters" ;
    rdfs:range atom:String .

<https://rpowell5064.github.io/guitaramp-suite/hexforge>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    rdfs:label "Hex Chain — Hex Forge" ;
    doap:name  "Hex Forge" ;
    mod:label  "Hex Forge" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 144 ;

    # Amp model rebuilds + cab IR loads run on the worker thread.
    lv2:requiredFeature urid:map , work:schedule ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData state:interface , work:interface ;

    patch:writable <https://rpowell5064.github.io/guitaramp-suite/hexforge#irfile> , <https://rpowell5064.github.io/guitaramp-suite/hexforge#ampnam> , <https://rpowell5064.github.io/guitaramp-suite/hexforge#drnam> , <https://rpowell5064.github.io/guitaramp-suite/hexforge#cabnam> ,
                   <https://rpowell5064.github.io/guitaramp-suite/hexforge#ps_name> , <https://rpowell5064.github.io/guitaramp-suite/hexforge#ps_index> , <https://rpowell5064.github.io/guitaramp-suite/hexforge#ps_apply> , <https://rpowell5064.github.io/guitaramp-suite/hexforge#meters> ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        atom:supports time:Position ;
        lv2:designation lv2:control ;
        rsz:minimumSize 8192 ;
        lv2:index 4 ; lv2:symbol "control" ; lv2:name "Control"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:designation lv2:control ;
        rsz:minimumSize 16384 ;
        lv2:index 5 ; lv2:symbol "notify" ; lv2:name "Notify"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "out_level" ; lv2:name "Output Level" ;
        units:unit units:db ;
        lv2:default -20.0 ; lv2:minimum -60.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 8 ; lv2:symbol "clip" ; lv2:name "Clip" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ; lv2:symbol "it_enable" ; lv2:name "Input Trim Enable" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 10 ; lv2:symbol "it_gain" ; lv2:name "IT Gain" ;
        units:unit units:db ;
        lv2:default 0.0 ; lv2:minimum -20.0 ; lv2:maximum 20.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 11 ; lv2:symbol "it_phase" ; lv2:name "IT Phase" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 12 ; lv2:symbol "it_hum" ; lv2:name "IT Hum Filter" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 13 ; lv2:symbol "it_humbk" ; lv2:name "IT Humbucker" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 14 ; lv2:symbol "it_hbamt" ; lv2:name "IT HB Amount" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 15 ; lv2:symbol "it_hbmodel" ; lv2:name "IT HB Model" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:scalePoint [ rdfs:label "'59 Bucker" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Norse Hammer" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Modern Flux" ; rdf:value 2 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 16 ; lv2:symbol "it_boost" ; lv2:name "IT Boost" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 17 ; lv2:symbol "it_boostamt" ; lv2:name "IT Boost Amt" ;
        units:unit units:db ;
        lv2:default 4.0 ; lv2:minimum 0.0 ; lv2:maximum 12.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 18 ; lv2:symbol "gt_pos" ; lv2:name "Gate Position" ;
        lv2:portProperty lv2:integer, lv2:enumeration, pprops:notOnGUI ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 13 ;
        lv2:scalePoint [ rdfs:label "1" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "2" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "3" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "4" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "5" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "6" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "7" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "8" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "9" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "10" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "11" ; rdf:value 11 ] ;
        lv2:scalePoint [ rdfs:label "12" ; rdf:value 12 ] ;
        lv2:scalePoint [ rdfs:label "13" ; rdf:value 13 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 19 ; lv2:symbol "gt_enable" ; lv2:name "Gate Enable" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 20 ; lv2:symbol "gt_thresh" ; lv2:name "Gate Threshold" ;
        units:unit units:db ;
        lv2:default -60.0 ; lv2:minimum -80.0 ; lv2:maximum 0.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 21 ; lv2:symbol "gt_attack" ; lv2:name "Gate Attack" ;
        units:unit units:ms ;
        lv2:default 2.0 ; lv2:minimum 0.1 ; lv2:maximum 50.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 22 ; lv2:symbol "gt_hold" ; lv2:name "Gate Hold" ;
        units:unit units:ms ;
        lv2:default 120.0 ; lv2:minimum 0.0 ; lv2:maximum 500.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 23 ; lv2:symbol "gt_release" ; lv2:name "Gate Release" ;
        units:unit units:ms ;
        lv2:default 250.0 ; lv2:minimum 10.0 ; lv2:maximum 2000.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 24 ; lv2:symbol "gt_hyst" ; lv2:name "Gate Hysteresis" ;
        units:unit units:db ;
        lv2:default 8.0 ; lv2:minimum 0.0 ; lv2:maximum 20.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 25 ; lv2:symbol "cp_pos" ; lv2:name "Comp Position" ;
        lv2:portProperty lv2:integer, lv2:enumeration, pprops:notOnGUI ;
        lv2:default 2 ; lv2:minimum 1 ; lv2:maximum 13 ;
        lv2:scalePoint [ rdfs:label "1" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "2" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "3" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "4" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "5" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "6" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "7" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "8" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "9" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "10" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "11" ; rdf:value 11 ] ;
        lv2:scalePoint [ rdfs:label "12" ; rdf:value 12 ] ;
        lv2:scalePoint [ rdfs:label "13" ; rdf:value 13 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 26 ; lv2:symbol "cp_enable" ; lv2:name "Comp Enable" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 27 ; lv2:symbol "cp_type" ; lv2:name "Comp Type" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
        lv2:scalePoint [ rdfs:label "5 Creature Amp" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Once76" ; rdf:value 1 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 28 ; lv2:symbol "cp_thresh" ; lv2:name "Comp Threshold" ;
        units:unit units:db ;
        lv2:default -18.0 ; lv2:minimum -60.0 ; lv2:maximum 0.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 29 ; lv2:symbol "cp_ratio" ; lv2:name "Comp Ratio" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 4 ;
        lv2:scalePoint [ rdfs:label "2:1" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "4:1" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "8:1" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "20:1" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Limit" ; rdf:value 4 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 30 ; lv2:symbol "cp_attack" ; lv2:name "Comp Attack" ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 31 ; lv2:symbol "cp_release" ; lv2:name "Comp Release" ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 32 ; lv2:symbol "cp_knee" ; lv2:name "Comp Knee" ;
        lv2:default 3.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 33 ; lv2:symbol "cp_makeup" ; lv2:name "Comp Makeup" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 34 ; lv2:symbol "fz_pos" ; lv2:name "Fuzz Position" ;
        lv2:portProperty lv2:integer, lv2:enumeration, pprops:notOnGUI ;
        lv2:default 3 ; lv2:minimum 1 ; lv2:maximum 13 ;
        lv2:scalePoint [ rdfs:label "1" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "2" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "3" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "4" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "5" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "6" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "7" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "8" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "9" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "10" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "11" ; rdf:value 11 ] ;
        lv2:scalePoint [ rdfs:label "12" ; rdf:value 12 ] ;
        lv2:scalePoint [ rdfs:label "13" ; rdf:value 13 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 35 ; lv2:symbol "fz_enable" ; lv2:name "Fuzz Enable" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 36 ; lv2:symbol "fz_pedal" ; lv2:name "Fuzz Pedal" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ;
        lv2:scalePoint [ rdfs:label "Italian Hero" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "I Know It" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Octavius" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Fuzz Zachary" ; rdf:value 3 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 37 ; lv2:symbol "fz_mode" ; lv2:name "Fuzz Variant" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 5 ;
        lv2:scalePoint [ rdfs:label "Delta" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Ovis" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Gotham" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Cold War" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Red Bear" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Boutique" ; rdf:value 5 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 38 ; lv2:symbol "fz_sustain" ; lv2:name "Fuzz Sustain" ;
        lv2:default 0.55 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 39 ; lv2:symbol "fz_tone" ; lv2:name "Fuzz Tone" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 40 ; lv2:symbol "fz_volume" ; lv2:name "Fuzz Volume" ;
        lv2:default 0.65 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 41 ; lv2:symbol "fz_bias" ; lv2:name "Fuzz Bias" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 42 ; lv2:symbol "fz_inputtrim" ; lv2:name "Fuzz Input Trim" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 43 ; lv2:symbol "fz_getemp" ; lv2:name "Fuzz Ge Temp" ;
        lv2:default 0.4 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 44 ; lv2:symbol "dr_pos" ; lv2:name "Drive Position" ;
        lv2:portProperty lv2:integer, lv2:enumeration, pprops:notOnGUI ;
        lv2:default 4 ; lv2:minimum 1 ; lv2:maximum 13 ;
        lv2:scalePoint [ rdfs:label "1" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "2" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "3" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "4" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "5" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "6" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "7" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "8" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "9" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "10" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "11" ; rdf:value 11 ] ;
        lv2:scalePoint [ rdfs:label "12" ; rdf:value 12 ] ;
        lv2:scalePoint [ rdfs:label "13" ; rdf:value 13 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 45 ; lv2:symbol "dr_enable" ; lv2:name "Drive Enable" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 46 ; lv2:symbol "dr_model" ; lv2:name "Drive Model" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 7 ;
        lv2:scalePoint [ rdfs:label "Green Man" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "New Dawn" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Dear Rodent Boy" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Neural (NAM)" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Grunge DS" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Gilded Horse" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "Super Nova" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "Preamp 250" ; rdf:value 7 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 47 ; lv2:symbol "dr_drive" ; lv2:name "Drive Drive" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 48 ; lv2:symbol "dr_tone" ; lv2:name "Drive Tone" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 49 ; lv2:symbol "dr_level" ; lv2:name "Drive Level" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
