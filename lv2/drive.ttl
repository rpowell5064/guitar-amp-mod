@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .

# NAM neural-model file parameter (used when Model = "Neural (NAM)").
<https://rpowell5064.github.io/guitaramp-suite/drive#nammodel>
    a lv2:Parameter ;
    rdfs:label "NAM Model" ;
    rdfs:range atom:Path ;
    mod:fileTypes "nammodel,nam" .

<https://rpowell5064.github.io/guitaramp-suite/drive>
    a lv2:Plugin, lv2:DistortionPlugin ;
    rdfs:label "Hex Chain — Drive/Boost" ;
    doap:name  "Hex Chain Drive" ;
    mod:label  "Drive" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 6 ;
    lv2:requiredFeature urid:map , work:schedule ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData state:interface , work:interface ;
    patch:writable <https://rpowell5064.github.io/guitaramp-suite/drive#nammodel> ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "model" ; lv2:name "Model" ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 7 ;
        lv2:scalePoint [ rdfs:label "Green Man"       ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "New Dawn"        ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Dear Rodent Boy" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Neural (NAM)"    ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Grunge DS"       ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Gilded Horse"    ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "Super Nova"      ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "Preamp 250"      ; rdf:value 7 ]
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ; lv2:symbol "drive" ; lv2:name "Drive" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "tone" ; lv2:name "Tone" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "mix" ; lv2:name "Mix" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "octave" ; lv2:name "Octave" ;
        lv2:default 0.3 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:designation lv2:control ;
        rsz:minimumSize 8192 ;
        lv2:index 9 ; lv2:symbol "control" ; lv2:name "Control"
    ] , [
        a lv2:OutputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:designation lv2:control ;
        rsz:minimumSize 8192 ;
        lv2:index 10 ; lv2:symbol "notify" ; lv2:name "Notify"
    ] ;

    # ── Custom MOD web GUI ────────────────────────────────────────────────────
    # Octave control is shown only for the Life Pedal (handled in script-drive.js).
    modgui:gui [
        modgui:resourcesDirectory <modgui-drive> ;
        modgui:iconTemplate <modgui-drive/icon-drive.html> ;
        modgui:stylesheet <modgui-drive/stylesheet-drive.css> ;
        modgui:javascript <modgui-drive/script-drive.js> ;
        modgui:screenshot <modgui-drive/screenshot-drive.png> ;
        modgui:thumbnail <modgui-drive/thumbnail-drive.png> ;
        modgui:brand "Hex Chain" ;
        modgui:label "Drive" ;
        modgui:model "mod-pedal-guitaramp-drive" ;
        modgui:port [
            lv2:index 0 ; lv2:symbol "model"  ; lv2:name "Model"
        ] , [
            lv2:index 1 ; lv2:symbol "drive"  ; lv2:name "Drive"
        ] , [
            lv2:index 2 ; lv2:symbol "tone"   ; lv2:name "Tone"
        ] , [
            lv2:index 3 ; lv2:symbol "level"  ; lv2:name "Level"
        ] , [
            lv2:index 4 ; lv2:symbol "mix"    ; lv2:name "Mix"
        ] , [
            lv2:index 5 ; lv2:symbol "octave" ; lv2:name "Octave"
        ] , [
            lv2:index 6 ; lv2:symbol "bypass" ; lv2:name "Bypass"
        ]
    ] .
