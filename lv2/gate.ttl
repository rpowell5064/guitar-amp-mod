@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://rpowell5064.github.io/guitaramp-suite/gate>
    a lv2:Plugin, lv2:GatePlugin ;
    rdfs:label "Hex Chain — Noise Gate" ;
    doap:name  "Hex Chain Noise Gate" ;
    mod:label  "Gate" ;
    mod:brand  "Hex Chain" ;
    doap:license <http://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ a foaf:Person ; foaf:name "Ryan Powell" ;
                      foaf:homepage <https://rpowell5064.github.io/guitaramp-suite/> ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 27 ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "threshold" ; lv2:name "Threshold" ;
        units:unit units:db ;
        lv2:default -60.0 ; lv2:minimum -80.0 ; lv2:maximum 0.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ; lv2:symbol "attack_ms" ; lv2:name "Attack" ;
        units:unit units:ms ;
        lv2:default 5.0 ; lv2:minimum 0.1 ; lv2:maximum 50.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "hold_ms" ; lv2:name "Hold" ;
        units:unit units:ms ;
        lv2:default 50.0 ; lv2:minimum 0.0 ; lv2:maximum 500.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "release_ms" ; lv2:name "Release" ;
        units:unit units:ms ;
        lv2:default 100.0 ; lv2:minimum 10.0 ; lv2:maximum 2000.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "hysteresis" ; lv2:name "Hysteresis" ;
        units:unit units:db ;
        lv2:default 6.0 ; lv2:minimum 0.0 ; lv2:maximum 20.0
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] ;

    modgui:gui [
        modgui:resourcesDirectory <modgui-gate> ;
        modgui:iconTemplate <modgui-gate/icon-gate.html> ;
        modgui:stylesheet <modgui-gate/stylesheet-gate.css> ;
        modgui:screenshot <modgui-gate/screenshot-gate.png> ;
        modgui:thumbnail <modgui-gate/thumbnail-gate.png> ;
        modgui:brand "Hex Chain" ;
        modgui:label "Gate" ;
        modgui:model "mod-pedal-guitaramp-gate" ;
        modgui:port [
            lv2:index 0 ; lv2:symbol "threshold"  ; lv2:name "Threshold"
        ] , [
            lv2:index 1 ; lv2:symbol "attack_ms"  ; lv2:name "Attack"
        ] , [
            lv2:index 2 ; lv2:symbol "hold_ms"    ; lv2:name "Hold"
        ] , [
            lv2:index 3 ; lv2:symbol "release_ms" ; lv2:name "Release"
        ] , [
            lv2:index 4 ; lv2:symbol "hysteresis" ; lv2:name "Hysteresis"
        ] , [
            lv2:index 5 ; lv2:symbol "bypass"     ; lv2:name "Bypass"
        ]
    ] .
